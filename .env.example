# ── Database ───────────────────────────────────────────────────
# Defaults to a local SQLite file — no setup needed for curl/Postman testing.
# Point at Postgres in production: postgresql://user:pass@host:5432/scanner
DATABASE_URL=sqlite:///./scanner.db

# ── Nuclei ─────────────────────────────────────────────────────
NUCLEI_BINARY=nuclei
NUCLEI_TAGS=cve,misconfig
NUCLEI_SEVERITY=critical,high,medium,low
NUCLEI_TIMEOUT_SECONDS=600

# ── OpenVAS / GVM ──────────────────────────────────────────────
OPENVAS_SOCKET_PATH=/run/gvmd/gvmd.sock
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=admin
OPENVAS_PORT_LIST_NAME=All IANA assigned TCP
OPENVAS_SCAN_CONFIG_NAME=Base
OPENVAS_SCANNER_NAME=OpenVAS Default
OPENVAS_CONNECT_TIMEOUT_SECONDS=300
OPENVAS_POLL_TIMEOUT_SECONDS=43200
OPENVAS_SOCKET_WAIT_SECONDS=60

# ── Credentials ────────────────────────────────────────────────
# Encrypts scan credentials (SSH/WinRM/SNMP) at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
