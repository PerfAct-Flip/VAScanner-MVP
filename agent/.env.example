# ── Backend ────────────────────────────────────────────────────
BACKEND_URL=https://scanner.example.com
# Unique per site/customer — this is what shows up as the target when
# creating an internal scan. Changing it after first run registers a NEW
# agent identity; it does not rename the existing one.
AGENT_NAME=customer-site-1
AGENT_TYPE=internal

# ── Polling ────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=60

# ── Discovery (nmap) ───────────────────────────────────────────
NMAP_BINARY=nmap
DISCOVERY_TIMEOUT_SECONDS=120
# Multiple ping-sweep passes catch hosts that missed the first pass (asleep,
# mid-reconnect, a dropped ARP reply) instead of reporting them as absent.
DISCOVERY_PASSES=2
DISCOVERY_RETRY_DELAY_SECONDS=15
# How many of nmap's most common TCP ports to check per host during
# discovery (nmap's --top-ports). Higher = more exposure visibility per
# scan, but a full /24 sweep takes proportionally longer.
DISCOVERY_TOP_PORTS=50

# ── Nuclei ─────────────────────────────────────────────────────
NUCLEI_BINARY=nuclei
NUCLEI_TAGS=cve,misconfig,network,iot,default-login
NUCLEI_SEVERITY=critical,high,medium,low
# 1800s (30min) — the network/iot/default-login tags add thousands of
# protocol-probe templates, which take much longer per-host than the
# original cve,misconfig-only set, especially against slow/mostly-closed
# devices like routers.
NUCLEI_TIMEOUT_SECONDS=1800

# ── Authenticated SSH audit ("openvas" engine) ─────────────────
SSH_AUDIT_TIMEOUT_SECONDS=20

# ── State ──────────────────────────────────────────────────────
# Where the one-time pairing key (from POST /agents/register) is stored
# after first run. Back this file up — it cannot be recovered from the
# backend if lost; you'd have to register under a new AGENT_NAME instead.
# STATE_PATH=~/.presence-agent/credentials.json
