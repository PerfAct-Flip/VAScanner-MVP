# ── Backend ────────────────────────────────────────────────────
BACKEND_URL=https://scanner.example.com
# Unique per site/customer — this is what shows up as the target when
# creating an internal scan. Changing it after first run registers a NEW
# agent identity; it does not rename the existing one.
AGENT_NAME=customer-site-1
AGENT_TYPE=internal

# ── Polling ────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=60

# ── Discovery (nmap) ───────────────────────────────────────────
NMAP_BINARY=nmap
DISCOVERY_TIMEOUT_SECONDS=120

# ── Nuclei ─────────────────────────────────────────────────────
NUCLEI_BINARY=nuclei
NUCLEI_TAGS=cve,misconfig
NUCLEI_SEVERITY=critical,high,medium,low
NUCLEI_TIMEOUT_SECONDS=600

# ── State ──────────────────────────────────────────────────────
# Where the one-time pairing key (from POST /agents/register) is stored
# after first run. Back this file up — it cannot be recovered from the
# backend if lost; you'd have to register under a new AGENT_NAME instead.
# STATE_PATH=~/.presence-agent/credentials.json
